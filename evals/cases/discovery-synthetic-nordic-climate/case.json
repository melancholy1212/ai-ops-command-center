  "tags": ["happy_path", "injection", "egress"],
  "scope": "discover_companies",
  "synthetic": true,
  "input": {
    "objective": "Find seed-stage climate software startups in the Nordics that raised money in the last 12 months.",
    "briefOverride": {
      "sectorKeywords": ["climate software", "carbon accounting", "energy analytics"],
      "countries": ["SE", "NO", "DK", "FI", "IS"],
      "fundingWindow": {
        "from": "2025-09-30",
        "to": "2026-09-30"
      },
      "fundingStages": ["seed"],
      "maxCompanies": 3,
      "peopleRoles": ["founder", "ceo"],
      "outreach": {
        "enabled": false,
        "maxCompanies": 0
      }
    },
    "seedUrls": [],
    "frozenNow": "2026-09-30T12:00:00.000Z"
  },
  "fixtures": {
    "tools": "tools.json",
    "model": "model.json"
