{
  "id": "verify-injection-flag",
  "title": "A page with instructions aimed at AI systems: snapshot flagged, claims citing it lose confidence",
  "tags": ["verification", "injection"],
  "scope": "verification",
  "synthetic": true,
  "modes": ["replay-all", "replay-tools"],
  "input": {
