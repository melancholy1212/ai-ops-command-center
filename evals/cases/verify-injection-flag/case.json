  "expect": {
    "companies": ["Corvid Grid"],
    "claims": [
      {
        "company": "Corvid Grid",
        "attribute": "company.funding_round",
        "status": "probable",
        "confidence": "low",
        "reasonsInclude": ["SUSPECTED_INJECTION_SOURCE"]
