            "leadInvestors": ["Copenhagen Seed Fund"],
            "otherInvestors": []
          }
        },
        "rawValue": "EUR 2 million seed round",
        "evidence": [
          {
            "url": "https://nordicbytes.example/2026/07/01/corvid-grid-seed",
            "quote": "Copenhagen startup Corvid Grid has raised EUR 2 million in seed funding"
          }
        ]
      },
      {
        "subject": {
          "kind": "new_company",
          "name": "Corvid Grid",
          "domainHint": "corvidgrid.example"
        },
        "assertion": {
          "attribute": "company.hq_country",
          "value": {
            "country": "DK"
          }
        },
        "rawValue": "Copenhagen, Denmark",
        "evidence": [
          {
            "url": "https://nordicbytes.example/2026/07/01/corvid-grid-seed",
            "quote": "Corvid Grid is based in Copenhagen, Denmark, and builds grid software"
          }
        ]
      }
    ]
  },
  "fixtures": {
    "tools": "tools.json",
    "model": "model.json"
