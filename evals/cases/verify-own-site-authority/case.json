{
  "id": "verify-own-site-authority",
  "title": "An article links the company name to its site: the profile reads it, and the company's own words verify its round, headquarters and sector",
  "tags": ["verification", "grounding"],
  "scope": "verification",
  "synthetic": true,
  "modes": ["replay-all", "replay-tools"],
  "input": {
    "objective": "Find seed-stage software startups in the Nordics that raised money in the last 12 months.",
    "briefOverride": {
      "sectorKeywords": ["software"],
      "countries": ["SE", "NO", "DK", "FI", "IS"],
      "fundingWindow": {
        "from": "2025-10-01",
        "to": "2026-09-30"
      },
      "fundingStages": ["pre_seed", "seed"],
      "maxCompanies": 5,
      "peopleRoles": ["founder", "ceo"],
      "outreach": {
        "enabled": false,
        "maxCompanies": 0
      }
    },
    "frozenNow": "2026-09-30T12:00:00.000Z",
    "claims": [
      {
        "subject": {
          "kind": "new_company",
          "name": "Brackenfield Labs",
          "domainHint": null
        },
        "assertion": {
          "attribute": "company.funding_round",
          "value": {
            "stage": "seed",
            "amount": 1800000,
            "currency": "EUR",
            "announcedOn": "2026-06-02",
            "leadInvestors": ["Fjord Capital"],
            "otherInvestors": []
          }
        },
        "rawValue": "EUR 1.8 million seed round",
        "evidence": [
          {
            "url": "https://oslotech.example/2026/06/02/brackenfield-labs-seed",
            "quote": "Brackenfield Labs has raised EUR 1.8 million in seed funding led by Fjord Capital"
          }
        ]
      },
      {
        "subject": {
          "kind": "new_company",
          "name": "Brackenfield Labs",
          "domainHint": null
        },
        "assertion": {
          "attribute": "company.hq_country",
          "value": {
            "country": "NO"
          }
        },
        "rawValue": "Oslo, Norway",
        "evidence": [
          {
            "url": "https://oslotech.example/2026/06/02/brackenfield-labs-seed",
            "quote": "Brackenfield Labs, based in Oslo, Norway, builds route-planning software"
          }
        ]
      }
    ],
    "profileClaims": [
      {
        "subject": {
          "kind": "new_company",
          "name": "Brackenfield Labs",
          "domainHint": null
        },
        "assertion": {
          "attribute": "company.funding_round",
          "value": {
            "stage": "seed",
            "amount": 1800000,
            "currency": "EUR",
            "announcedOn": "2026-06-02",
            "leadInvestors": ["Fjord Capital"],
            "otherInvestors": []
          }
        },
        "rawValue": "EUR 1.8 million in seed funding",
        "evidence": [
          {
            "url": "https://brackenfield.example/",
            "quote": "June 2, 2026: Brackenfield Labs has raised EUR 1.8 million in seed funding led by Fjord Capital"
          }
        ]
      },
      {
        "subject": {
          "kind": "new_company",
          "name": "Brackenfield Labs",
          "domainHint": null
        },
        "assertion": {
          "attribute": "company.hq_country",
          "value": {
            "country": "NO"
          }
        },
        "rawValue": "Oslo, Norway",
        "evidence": [
          {
            "url": "https://brackenfield.example/",
            "quote": "Brackenfield Labs is headquartered in Oslo, Norway"
          }
        ]
      },
      {
        "subject": {
          "kind": "new_company",
          "name": "Brackenfield Labs",
          "domainHint": null
        },
        "assertion": {
          "attribute": "company.sector",
          "value": {
            "tags": ["route-planning software"]
          }
        },
        "rawValue": "route-planning software",
        "evidence": [
          {
            "url": "https://brackenfield.example/",
            "quote": "Brackenfield Labs builds route-planning software for municipal snow clearing"
          }
        ]
      }
    ]
  },
  "fixtures": {
    "tools": "tools.json",
    "model": "model.json"
  },
  "expect": {
    "companies": ["Brackenfield Labs"],
    "claims": [
      {
        "company": "Brackenfield Labs",
        "attribute": "company.funding_round",
        "status": "verified",
        "reasonsInclude": ["AUTHORITATIVE_SOURCE"]
      },
      {
        "company": "Brackenfield Labs",
        "attribute": "company.hq_country",
        "status": "verified",
        "reasonsInclude": ["INDEPENDENT_SOURCES"]
      },
      {
        "company": "Brackenfield Labs",
        "attribute": "company.sector",
        "status": "verified"
      }
    ],
    "report": {
      "ranked": ["Brackenfield Labs"],
      "excluded": []
    },
    "limits": {
      "maxCostUsdMicros": 20000,
      "maxLlmCalls": 6,
      "maxWallClockMs": 120000
    }
  }
}
