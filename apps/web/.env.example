# Local values are written to .env.local (git-ignored) by `pnpm setup:local`.
# In production these are set in Vercel. See docs/deployment.md.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# The publishable key only. Never put a secret or service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key from `pnpm exec supabase status`>
