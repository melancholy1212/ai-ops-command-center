# Local values are written to .env.local (git-ignored) by `pnpm setup:local`.
# In production these are set in Railway. See docs/deployment.md.

# Connection as the aoc_service login role (never the service-role or postgres credentials).
DATABASE_URL=postgresql://aoc_service:<password>@127.0.0.1:55322/postgres
LOG_LEVEL=info
HEALTH_PORT=8081
# The MCP server's endpoint and the Ed25519 private key that signs capability tokens (generated by setup:local).
MCP_URL=http://127.0.0.1:8082/mcp
CAPABILITY_PRIVATE_JWK={"kty":"OKP","crv":"Ed25519","x":"<public key>","d":"<private key>"}
# Model providers. At least one is needed for agents to run; the router uses what is configured.
EARTHRUNTIME_API_KEY=<placeholder: add your own key; never commit it>
ANTHROPIC_API_KEY=<placeholder: optional; Anthropic Console billing, not Claude Code Max>
# Optional: BazaarLink's rate-limited free tier, tried before Earthruntime (bazaarlink.ai, an OpenAI-compatible gateway).
BAZAARLINK_API_KEY=<placeholder: optional; never commit it>
