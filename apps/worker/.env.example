# Local values are written to .env.local (git-ignored) by `pnpm setup:local`.
# In production these are set in Railway. See docs/deployment.md.

# Connection as the aoc_service login role (never the service-role or postgres credentials).
DATABASE_URL=postgresql://aoc_service:<password>@127.0.0.1:55322/postgres
LOG_LEVEL=info
HEALTH_PORT=8081
