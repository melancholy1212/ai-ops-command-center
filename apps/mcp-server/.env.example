# Local values are written to .env.local (git-ignored) by `pnpm setup:local`.
# In production these are set in Railway. See docs/deployment.md.

# Connection as the aoc_service login role (never the service-role or postgres credentials).
DATABASE_URL=postgresql://aoc_service:<password>@127.0.0.1:55322/postgres
LOG_LEVEL=info
PORT=8082
# The worker's Ed25519 public key as a JWK (generated by setup:local). Verification only.
CAPABILITY_PUBLIC_JWK={"kty":"OKP","crv":"Ed25519","x":"<public key>"}
# Search provider (https://app.tavily.com). Optional locally: without it web_search reports PROVIDER_UNAVAILABLE.
TAVILY_API_KEY=<placeholder: add your own key; never commit it>
# Optional extra domains the fetcher refuses, comma-separated.
FETCH_DENYLIST=
